# Bu dosyayı ".env" adıyla kopyalayın ve Google API anahtarınızı yazın.
# Anahtar yoksa uygulama yine çalışır; yerel (çevrimdışı) şablon kullanılır.
GOOGLE_API_KEY=your_google_api_key_here

# İsteğe bağlı: kullanılacak Gemini modeli (varsayılan: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
